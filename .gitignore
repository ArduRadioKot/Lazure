src/mobile/android/src/main/assets/models/
# Bundled LLM (Qwen3 0.6B INT4 .litertlm): placed by tools/models/fetch_models.sh
src/mobile/android/src/main/assets/bundled_llm/
# sherpa-onnx static JNI build (24+ MB per ABI), also placed by fetch_models.sh
src/mobile/android/src/main/jniLibs/*/libsherpa-onnx-jni.so
src/mobile/android/src/main/jniLibs/*/libonnxruntime.so
*.onnx
*.litertlm
*.gguf
*.pt
*.pth
