# Переменные для вспомогательных скриптов (tools/). Приложение их не читает: его настройки задаются в интерфейсе.
# Скопируйте в .env при необходимости. Секретов здесь нет и быть не должно.

# Android SDK для сборки и run-android.sh
ANDROID_SDK_ROOT=/path/to/Android/sdk

# adb для tools/bench/evaluate_speakers.py (читает SPEECH_EVAL из logcat)
ADB=adb

# Каталог с синтетическими диалогами и их разметкой (tools/bench/gen_dialogs.py)
BENCH_DIR=tools/bench

# ABI для сборки: arm64-v8a (телефон) или arm64-v8a,x86_64 (телефон + эмулятор); передаётся как -Plazure.abis=...
LAZURE_ABIS=arm64-v8a
